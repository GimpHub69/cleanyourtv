<?xml version="1.0" encoding="utf-8"?>
<!-- Reader mode: one scrolling column, 1000dp wide at most, centred; Up and Down scroll it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF14161A"
    android:focusable="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="140dp"
        android:paddingEnd="140dp"
        android:paddingTop="40dp"
        android:paddingBottom="60dp">

        <TextView
            android:id="@+id/readerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:lineSpacingMultiplier="1.1" />

        <TextView
            android:id="@+id/readerMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#99FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/readerPicture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:maxHeight="320dp"
            android:scaleType="fitStart"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/readerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#E6FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="#66FFFFFF"
            android:textSize="14sp"
            android:text="@string/reader_hint" />
    </LinearLayout>
</ScrollView>
